# Copy to .env and fill in what you need. Every variable is read in config.py.
# At least one LLM provider key is required for the Director Studio; the
# failover client tries the configured providers in turn. The *_API_KEYS
# variants take a comma-separated list for key rotation.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Where projects and renders are written (default: ./outputs)
# OUTPUT_DIR=

# Optional Postgres run registry for the API. Leave blank for in-memory.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Background run limits for the API
# PIPELINE_MAX_CONCURRENCY=
# PIPELINE_TIMEOUT_SECONDS=

# Opt-in Google Veo provider for the Video Generation Engine (paid)
# GOOGLE_VEO_API_KEY=

# Dashboard origin allowed by CORS and cookie settings
# FRONTEND_BASE_URL=http://localhost:3000
