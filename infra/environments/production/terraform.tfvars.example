# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored
# (see infra/.gitignore) - never commit real values, though nothing below
# is actually a secret (secrets live in SSM/Secrets Manager, not tfvars -
# see modules/secrets and infra/README.md).

aws_region   = "ap-south-1"
project_name = "ai-video-studio"
environment  = "production"

azs = ["ap-south-1a", "ap-south-1b"]

# The deployed frontend's real origin (stays on Vercel - see
# docs/aws-production-architecture.md §0). Comma-separate multiple origins.
cors_origins = "https://your-frontend.vercel.app"

# Leave both empty to launch without a custom domain first (HTTP-only ALB
# listener) - see modules/alb and modules/dns.
domain_name          = ""
create_dns_zone      = false
existing_dns_zone_id = ""

# Set by the deploy pipeline once real images exist in ECR - see
# docs/aws-production-architecture.md §9. The default value in variables.tf
# will not resolve, deliberately, so a stray apply can't deploy nothing.
# image_tag = "sha-abc1234"

alarm_email = ""

# SES password-reset email (docs/authentication.md's Password Reset
# Status). Not secrets - just which verified identity/region/frontend link
# the API task is allowed to send from and point at; credentials always
# come from the ECS task role (modules/iam), never a key pair here. Leave
# ses_from_email empty to disable email delivery entirely - variables.tf's
# defaults already match the verified identity, so these three lines are
# only needed if you want to override them.
# ses_region         = "ap-south-1"
# ses_from_email     = "tawsifk35@gmail.com"
# frontend_base_url  = "https://ai-video-studio-dashboard.vercel.app"
